meta {
  name: List reviews
  type: http
  seq: 1
}

get {
  url: {{base_url}}/reviews
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("data e uma lista", function () {
    expect(res.body.data).to.be.an("array");
  });
}
