meta {
  name: Show image
  type: http
  seq: 1
}

get {
  url: {{base_url}}/images/{{image_id}}
  body: none
  auth: none
}

headers {
  Accept: */*
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("content-type de imagem", function () {
    expect(res.headers["content-type"]).to.match(/^image\//);
  });
}

docs {
  Rota publica. Retorna os bytes da imagem com o Content-Type correto,
  nao um JSON. O image_id e preenchido automaticamente ao criar uma
  avaliacao com imagem.
}
