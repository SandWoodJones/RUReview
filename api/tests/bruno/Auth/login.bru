meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "name": "admin",
    "password": "admin123"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.token) {
    bru.setEnvVar("token", res.body.data.token);
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("retorna token", function () {
    expect(res.body.data.token).to.be.a("string");
  });
}

docs {
  Faz login como o admin criado pelo seeder e salva o token na variavel
  de ambiente {{token}}. As demais requisicoes autenticadas usam esse token.
  Troque name/password por um usuario comum para testar o fluxo nao-admin.
}
