meta {
  name: Me
  type: http
  seq: 3
}

get {
  url: {{base_url}}/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Accept: application/json
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("retorna usuario autenticado", function () {
    expect(res.body.data.id).to.be.a("number");
  });
}
